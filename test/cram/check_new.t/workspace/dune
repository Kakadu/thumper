; The documented rule: the baseline is a dependency, so dune copies it into
; the action's directory and reruns the action when it changes; an unchanged
; executable and baseline is a cache hit. (--quick -f alloc keeps the session
; fast and its verdicts exact; the shipped rule is flagless.)

(rule
 (alias bench)
 (locks %{project_root}/bench)
 (deps
  (glob_files *.thumper))
 (action
  (run %{exe:bench.exe} --quick -f alloc)))
